{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": false,
  "functions": {
    "api/evaluate.mjs": {
      "maxDuration": 300
    },
    "api/evaluate-with-usage.mjs": {
      "maxDuration": 300
    },
    "api/evaluate-router.mjs": {
      "maxDuration": 300
    }
  },
  "rewrites": [
    {
      "source": "/api/evaluate-with-usage",
      "destination": "/api/evaluate-router"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "no-referrer" }
      ]
    }
  ]
}
